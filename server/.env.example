# Copy this file to ".env" (in this same /server folder) and fill in the values.
# ".env" is private and must NEVER be committed to GitHub. Only this ".env.example" is committed.

# Dify: open your published app -> "API Access". The page shows the API base URL and lets you create a key.
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=

# Which website addresses may call this server (comma-separated).
CLIENT_ORIGIN=http://localhost:5173

# Optional
PORT=3001
RATE_LIMIT_PER_MINUTE=6
